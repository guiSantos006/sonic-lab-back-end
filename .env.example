# ===================================================================
# SONIC LAB BACK-END - Environment Variables Template (.env.example)
# ===================================================================
# Copie este arquivo para .env na raiz do projeto para customizar suas variaveis locais:
# cp .env.example .env
#
# NOTA: O arquivo .env esta no .gitignore e NUNCA deve ser commitado no Git.
# Todas as variaveis possuem valores padrao compativeis com o docker-compose.yml local.
# ===================================================================

# -------------------------------------------------------------------
# Perfil Spring Boot (Opcional em dev; use 'prod' em producao)
# -------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=prod

# -------------------------------------------------------------------
# Servidor & Aplicacao
# -------------------------------------------------------------------
PORT=8080
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=200MB
MAX_DEMO_BYTES=20971520
PAGEABLE_DEFAULT_SIZE=50

# -------------------------------------------------------------------
# Banco de Dados (MongoDB)
# -------------------------------------------------------------------
# Opcao 1 (Obrigatoria em Producao / MongoDB Atlas):
# Defina MONGODB_URI completa. Se fornecida, sobrepoe as opcoes abaixo.
# MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster.mongodb.net/soniclab_db?retryWrites=true&w=majority

# Opcao 2 (Padrao de Desenvolvimento com Docker Compose):
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=soniclab_db
MONGODB_USERNAME=admin
MONGODB_PASSWORD=password
MONGODB_AUTH_SOURCE=admin

# -------------------------------------------------------------------
# Seguranca & JWT
# -------------------------------------------------------------------
# IMPORTANTE: Em producao, gere uma chave forte com >= 256 bits (ex: openssl rand -base64 64)
JWT_SECRET=soniclab-super-secret-key-for-development-and-tests-2026
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=sonic-lab-api

# -------------------------------------------------------------------
# Frontend & CORS
# -------------------------------------------------------------------
# Em producao, informe a URL exata da Vercel (ex: https://sonic-lab.vercel.app)
FRONTEND_URL=http://localhost:3000

# -------------------------------------------------------------------
# Envio de E-mails (Mailtrap Sandbox / SMTP)
# -------------------------------------------------------------------
MAIL_HOST=sandbox.smtp.mailtrap.io
# Use 587 (padrao) ou 2525 caso o provedor de hospedagem bloqueie a porta 587
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_TRUST=sandbox.smtp.mailtrap.io
MAIL_DEBUG=false
MAIL_FROM=SonicLab <noreply@soniclab.com>

# -------------------------------------------------------------------
# Armazenamento de Arquivos (Storage)
# -------------------------------------------------------------------
# 'local' para desenvolvimento em disco; 's3' para AWS S3 em producao
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_LOCAL_BASE_URL=http://localhost:8080/uploads/

# -------------------------------------------------------------------
# AWS S3 (Obrigatorio quando STORAGE_TYPE=s3)
# -------------------------------------------------------------------
S3_BUCKET=
AWS_REGION=us-east-2
S3_URL_DURATION_MINUTES=15
S3_PUBLIC_BASE_URL=
# Em ambientes sem IAM Role (ex: Render), defina via variaveis de ambiente seguras:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional: apenas para emuladores S3 locais (ex: LocalStack)
AWS_ENDPOINT_URL=
S3_PATH_STYLE_ACCESS=false
