# ===================================================================
# SONIC LAB BACK-END - Environment Variables Template (.env.example)
# ===================================================================
# Copie este arquivo para .env na raiz do projeto para customizar suas variaveis locais:
# cp .env.example .env
#
# NOTA: O arquivo .env esta no .gitignore e NUNCA deve ser commitado no Git.
# Todas as variaveis possuem valores padrao compativeis com o docker-compose.yml local.
# ===================================================================

# -------------------------------------------------------------------
# Servidor & Aplicacao
# -------------------------------------------------------------------
PORT=8080
MAX_FILE_SIZE=200MB
MAX_REQUEST_SIZE=200MB
PAGEABLE_DEFAULT_SIZE=50

# -------------------------------------------------------------------
# Banco de Dados (MongoDB)
# -------------------------------------------------------------------
# Opcao 1 (Recomendada para Producao / MongoDB Atlas):
# Defina MONGODB_URI completa. Se fornecida, sobrepoe as opcoes abaixo.
# MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster.mongodb.net/soniclab_db?retryWrites=true&w=majority

# Opcao 2 (Padrao de Desenvolvimento com Docker):
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=soniclab_db
MONGODB_USERNAME=admin
MONGODB_PASSWORD=password
MONGODB_AUTH_SOURCE=admin

# -------------------------------------------------------------------
# Seguranca & JWT
# -------------------------------------------------------------------
# IMPORTANTE: Em producao, gere uma chave forte (ex: openssl rand -base64 64)
JWT_SECRET=soniclab-super-secret-key-for-development-and-tests-2026
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=sonic-lab-api

# -------------------------------------------------------------------
# Frontend & Integracao
# -------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# -------------------------------------------------------------------
# Envio de E-mails (Mailtrap / SMTP Provedor)
# -------------------------------------------------------------------
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
# Obtenha suas credenciais no Mailtrap (ou provedor de sua escolha como SendGrid/Resend/AWS SES):
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_TRUST=sandbox.smtp.mailtrap.io
MAIL_DEBUG=false
MAIL_FROM=SonicLab <noreply@soniclab.com>

# -------------------------------------------------------------------
# Armazenamento de Arquivos (Storage)
# -------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_LOCAL_BASE_URL=http://localhost:8080/uploads/
